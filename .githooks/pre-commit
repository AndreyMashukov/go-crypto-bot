#!/usr/bin/env bash
#
# go-crypto-bot pre-commit hook.
#
# Repo layout: Go module lives under `server/`. This hook runs the Go
# toolchain from there but resolves staged paths relative to the repo root.
#
# No bypass. --no-verify / CLAUDE_HOOKS_DISABLED / CI=true / core.hooksPath
# overrides are not honored — if a check fails, fix the underlying issue.
#
# Install: git config core.hooksPath .githooks/  (or `make hooks`)
#
# Checks (in order, all BLOCKING):
#   0. AI-trace files in stage  — CLAUDE.md / .claude/ etc must never be committed
#   1. gofmt -l                 — staged server/**/*.go
#   2. go vet ./...             — from server/
#   3. go build ./...           — from server/
#   4. golangci-lint run        — from server/, --new-from-rev=HEAD
#   5. go-lint ./...            — from server/, on staged packages
#   6. Source-without-test      — server/**/*.go must pair with _test.go
#   7. go test                  — paired test set in staged packages

set -euo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
cd "$PROJECT_ROOT"
SERVER_DIR="server"

BLOCK=0
RED='\033[0;31m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
GRAY='\033[0;90m'
RESET='\033[0m'

# ---- Gather staged files --------------------------------------------------

STAGED="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$STAGED" ] && exit 0

# All staged .go files (added/modified/renamed/copied), repo-root–relative.
STAGED_GO="$(printf "%s\n" "$STAGED" | grep -E '^server/.*\.go$' || true)"

# .go files whose CONTENT changed (added/modified/type-changed). Renames are
# not in this set — they preserve content by definition, so vet/build/lint/
# test have nothing to verify. This isn't a bypass; pure git-mv coda cannot
# regress on its own bytes.
STAGED_GO_CONTENT="$(git diff --cached --name-only --diff-filter=AMT \
    | grep -E '^server/.*\.go$' || true)"

STAGED_GO_SRC="$(printf "%s\n" "$STAGED_GO_CONTENT" | grep -vE '_test\.go$' || true)"
STAGED_GO_TEST="$(printf "%s\n" "$STAGED_GO_CONTENT" | grep -E '_test\.go$' || true)"

# Same content-changed files, but as paths relative to server/.
STAGED_GO_REL="$(printf "%s\n" "$STAGED_GO_CONTENT" | sed 's|^server/||')"

printf "%b\n" "${BLUE}[hooks] pre-commit: checking $(printf "%s\n" "$STAGED" | wc -l) staged file(s)${RESET}"

# Rename-only short-circuit: if every staged .go file is a rename (content
# preserved), checks 1–7 have nothing to verify. We still run check 0 below
# (AI traces — metadata-only). Then exit clean.
RENAME_ONLY=0
if [ -n "$STAGED_GO" ] && [ -z "$STAGED_GO_CONTENT" ]; then
    printf "%b\n" "${BLUE}[hooks] rename-only Go changes detected — skipping content-based checks${RESET}"
    RENAME_ONLY=1
    # Zero out the variables so the per-check guards (each tests STAGED_GO)
    # silently skip without re-implementing the rename detection.
    STAGED_GO=""
    STAGED_GO_SRC=""
    STAGED_GO_TEST=""
    STAGED_GO_REL=""
fi

# ---- Check 0: AI-trace files never enter the index ------------------------

AI_TRACES="$(printf "%s\n" "$STAGED" | grep -E '(^|/)(CLAUDE\.md|claude\.md|AGENTS\.md|\.cursorrules|copilot-instructions\.md)$|(^|/)\.claude/|(^|/)\.cursor/|(^|/)\.aider' || true)"
if [ -n "$AI_TRACES" ]; then
    printf "%b\n" "${RED}[hooks] AI-agent traces staged for commit — these must stay local:${RESET}"
    printf "%s\n" "$AI_TRACES" | sed 's/^/    /'
    printf "%b\n" "${GRAY}  Fix: git restore --staged <files>; ensure .git/info/exclude has these patterns.${RESET}"
    BLOCK=1
fi

# ---- Check 1: gofmt -l ----------------------------------------------------

if [ -n "$STAGED_GO" ]; then
    FMT_OUT="$(printf "%s\n" "$STAGED_GO" | xargs gofmt -l 2>&1 || true)"
    if [ -n "$FMT_OUT" ]; then
        printf "%b\n" "${RED}[hooks] gofmt diff in staged files:${RESET}"
        printf "%s\n" "$FMT_OUT" | sed 's/^/    /'
        printf "%b\n" "${GRAY}  Fix: gofmt -w <files>, then re-stage.${RESET}"
        BLOCK=1
    fi
fi

# ---- Check 2: go vet ------------------------------------------------------

if [ -n "$STAGED_GO" ]; then
    if ! (cd "$SERVER_DIR" && go vet ./...) > /tmp/go-crypto-bot.vet.out 2>&1; then
        printf "%b\n" "${RED}[hooks] go vet failures:${RESET}"
        tail -40 /tmp/go-crypto-bot.vet.out | sed 's/^/    /'
        BLOCK=1
    fi
fi

# ---- Check 3: go build ----------------------------------------------------

if [ -n "$STAGED_GO" ]; then
    if ! (cd "$SERVER_DIR" && go build ./...) > /tmp/go-crypto-bot.build.out 2>&1; then
        printf "%b\n" "${RED}[hooks] go build failed:${RESET}"
        tail -40 /tmp/go-crypto-bot.build.out | sed 's/^/    /'
        BLOCK=1
    fi
fi

# ---- Check 4: golangci-lint -----------------------------------------------

if [ -n "$STAGED_GO" ]; then
    if ! (cd "$SERVER_DIR" && golangci-lint run --config=../.golangci.yml --new-from-rev=HEAD --timeout=2m) \
            > /tmp/go-crypto-bot.lint.out 2>&1; then
        printf "%b\n" "${RED}[hooks] golangci-lint findings:${RESET}"
        tail -60 /tmp/go-crypto-bot.lint.out | sed 's/^/    /'
        printf "%b\n" "${GRAY}  Fix the issues above and re-stage. Suppression directives are banned (see go-lint/nolintdirective).${RESET}"
        BLOCK=1
    fi
fi

# ---- Check 5: go-lint (AI-bloat analyzers) --------------------------------

if [ -n "$STAGED_GO" ]; then
    if command -v go-lint >/dev/null 2>&1; then
        STAGED_PKGS_REL="$(printf "%s\n" "$STAGED_GO_REL" | xargs -I{} dirname {} | sort -u | sed 's|^|./|')"
        if ! (cd "$SERVER_DIR" && go-lint $STAGED_PKGS_REL) > /tmp/go-crypto-bot.ailint.out 2>&1; then
            printf "%b\n" "${RED}[hooks] go-lint (AI-bloat) findings:${RESET}"
            tail -60 /tmp/go-crypto-bot.ailint.out | sed 's/^/    /'
            BLOCK=1
        fi
    else
        printf "%b\n" "${YELLOW}[hooks] go-lint binary not on PATH — skipping AI-bloat checks${RESET}"
        printf "%b\n" "${GRAY}  Install: go install github.com/AndreyMashukov/go-lint/cmd/go-lint@latest${RESET}"
    fi
fi

# ---- Check 6: source-without-test (BLOCKING) ------------------------------

MISSING=""
SKIP_PATTERNS='/model/|/config/|/event/[^/]+\.go$|^server/main\.go$'
while IFS= read -r src; do
    [ -z "$src" ] && continue
    printf "%s\n" "$src" | grep -qE "$SKIP_PATTERNS" && continue
    base="$(basename "$src" .go)"
    dir="$(dirname "$src")"
    test_file="${dir}/${base}_test.go"
    if printf "%s\n" "$STAGED_GO_TEST" | grep -qx "$test_file"; then continue; fi
    if [ -f "$PROJECT_ROOT/$test_file" ]; then continue; fi
    MISSING="${MISSING}    ${src} → need ${test_file}\n"
done <<< "$STAGED_GO_SRC"

if [ -n "$MISSING" ]; then
    printf "%b\n" "${RED}[hooks] source files staged without paired _test.go:${RESET}"
    printf "%b" "$MISSING"
    printf "%b\n" "${GRAY}  Write the tests. No tests = no commit. Pure-data files (model/, config/, event/) are exempt.${RESET}"
    BLOCK=1
fi

# ---- Check 7: go test (paired set) ----------------------------------------

if [ -n "$STAGED_GO" ] && [ "$BLOCK" = "0" ]; then
    TEST_PKGS_REL="$(printf "%s\n" "$STAGED_GO_REL" | xargs -I{} dirname {} | sort -u | sed 's|^|./|')"
    if [ -n "$TEST_PKGS_REL" ]; then
        if ! (cd "$SERVER_DIR" && go test -count=1 -timeout=60s $TEST_PKGS_REL) \
                > /tmp/go-crypto-bot.test.out 2>&1; then
            printf "%b\n" "${RED}[hooks] go test failures in staged packages:${RESET}"
            tail -60 /tmp/go-crypto-bot.test.out | sed 's/^/    /'
            BLOCK=1
        fi
    fi
fi

# ---- ui/ checks (Nuxt + Symfony + Go microservices) -----------------------
# Each ui/<layer> check runs only if its docker-compose stack is up.
# Stack not up → instructive skip (we cannot fall back to host tooling per
# the "runtime in containers only" policy).

compose_running() {
    # $1 = working dir of compose project ; $2 = service name
    (cd "$1" && docker compose ps --services --status=running 2>/dev/null | grep -qx "$2")
}

# ---- Check 8: ui/app — Nuxt (ESLint + typecheck) --------------------------

STAGED_UI_APP="$(printf "%s\n" "$STAGED" | grep -E '^ui/app/.*\.(vue|ts|tsx|js|mjs|cjs)$' | grep -vE '^ui/app/(\.nuxt|\.output|node_modules)/' || true)"
if [ -n "$STAGED_UI_APP" ]; then
    if compose_running "ui/app" "frontend"; then
        if ! (cd ui/app && docker compose exec -T frontend yarn lint) > /tmp/go-crypto-bot.uiapp-lint.out 2>&1; then
            printf "%b\n" "${RED}[hooks] ESLint findings in ui/app:${RESET}"
            tail -60 /tmp/go-crypto-bot.uiapp-lint.out | sed 's/^/    /'
            BLOCK=1
        fi
        if ! (cd ui/app && docker compose exec -T frontend yarn typecheck) > /tmp/go-crypto-bot.uiapp-tc.out 2>&1; then
            printf "%b\n" "${RED}[hooks] typecheck failures in ui/app:${RESET}"
            tail -60 /tmp/go-crypto-bot.uiapp-tc.out | sed 's/^/    /'
            BLOCK=1
        fi
    else
        printf "%b\n" "${YELLOW}[hooks] ui/app frontend container is not running — skipping ESLint/typecheck.${RESET}"
        printf "%b\n" "${GRAY}  Start it to enable the gate:  (cd ui/app && make up)${RESET}"
        printf "%b\n" "${GRAY}  CI (ui-app.yml) still gates the merge.${RESET}"
    fi
fi

# ---- Check 9: ui/server — Symfony (php-cs-fixer + phpstan + rector) -------

STAGED_UI_SERVER="$(printf "%s\n" "$STAGED" | grep -E '^ui/server/.*\.php$' | grep -vE '^ui/server/(var|vendor|microservices)/' || true)"
if [ -n "$STAGED_UI_SERVER" ]; then
    if ! compose_running "ui/server" "backend"; then
        printf "%b\n" "${YELLOW}[hooks] ui/server backend container is not running — skipping php-cs-fixer/phpstan/rector.${RESET}"
        printf "%b\n" "${GRAY}  Start it to enable the gate:  (cd ui/server && make up)${RESET}"
        printf "%b\n" "${GRAY}  CI (ui-server.yml) still gates the merge.${RESET}"
        STAGED_UI_SERVER=""
    fi
fi
if [ -n "$STAGED_UI_SERVER" ]; then
    if compose_running "ui/server" "backend"; then
        # php-cs-fixer (staged files only — list them inside the container)
        STAGED_REL="$(printf "%s\n" "$STAGED_UI_SERVER" | sed 's|^ui/server/||' | tr '\n' ' ')"
        if ! (cd ui/server && docker compose exec -T backend vendor/bin/php-cs-fixer fix --dry-run --diff \
                --config=.php-cs-fixer.dist.php --allow-risky=yes $STAGED_REL) \
                > /tmp/go-crypto-bot.uisvr-cs.out 2>&1; then
            printf "%b\n" "${RED}[hooks] php-cs-fixer findings in ui/server:${RESET}"
            tail -60 /tmp/go-crypto-bot.uisvr-cs.out | sed 's/^/    /'
            BLOCK=1
        fi
        # phpstan (full project — boundary effects)
        if ! (cd ui/server && docker compose exec -T backend vendor/bin/phpstan analyse --memory-limit=1G --no-progress) \
                > /tmp/go-crypto-bot.uisvr-stan.out 2>&1; then
            printf "%b\n" "${RED}[hooks] phpstan findings:${RESET}"
            tail -60 /tmp/go-crypto-bot.uisvr-stan.out | sed 's/^/    /'
            BLOCK=1
        fi
        # rector --dry-run (full project)
        if ! (cd ui/server && docker compose exec -T backend vendor/bin/rector process --dry-run --no-progress-bar) \
                > /tmp/go-crypto-bot.uisvr-rector.out 2>&1; then
            printf "%b\n" "${RED}[hooks] rector findings (run 'make rector' to apply):${RESET}"
            tail -60 /tmp/go-crypto-bot.uisvr-rector.out | sed 's/^/    /'
            BLOCK=1
        fi
    else
        printf "%b\n" "${RED}[hooks] ui/server backend container is not running.${RESET}"
        printf "%b\n" "${GRAY}  Start it and re-commit:  (cd ui/server && make up)${RESET}"
        BLOCK=1
    fi
fi

# ---- Check 10: ui/server/microservices — Go services ----------------------

STAGED_UI_MS="$(printf "%s\n" "$STAGED" | grep -E '^ui/server/microservices/.*\.go$' || true)"
STAGED_UI_MS_CONTENT="$(git diff --cached --name-only --diff-filter=AMT \
    | grep -E '^ui/server/microservices/.*\.go$' || true)"
if [ -n "$STAGED_UI_MS" ] && [ -z "$STAGED_UI_MS_CONTENT" ]; then
    printf "%b\n" "${BLUE}[hooks] rename-only changes in ui/server/microservices — skipping${RESET}"
    STAGED_UI_MS=""
fi
if [ -n "$STAGED_UI_MS" ]; then
    if ! compose_running "ui/server" "backend"; then
        printf "%b\n" "${YELLOW}[hooks] ui/server backend container is not running — skipping microservices vet/build/go-lint.${RESET}"
        printf "%b\n" "${GRAY}  Start it to enable the gate:  (cd ui/server && make up)${RESET}"
        printf "%b\n" "${GRAY}  CI (ui-microservices.yml) still gates the merge.${RESET}"
        STAGED_UI_MS=""
    else
        # Group by module root (e.g. ui/server/microservices/signal-server).
        MS_MODS="$(printf "%s\n" "$STAGED_UI_MS" | awk -F/ '{print $1"/"$2"/"$3"/"$4}' | sort -u)"
        while IFS= read -r mod; do
            [ -z "$mod" ] && continue
            mod_in_container="/srv/www/${mod#ui/server/}"
            # gofmt — staged files only; runs inside the backend container.
            FILES_IN_MOD_REL="$(printf "%s\n" "$STAGED_UI_MS" | grep "^${mod}/" | sed "s|^${mod}/||" | tr '\n' ' ')"
            FMT_OUT="$( (cd ui/server && docker compose exec -T backend sh -c "cd ${mod_in_container} && gofmt -l ${FILES_IN_MOD_REL}") 2>&1 || true)"
            if [ -n "$FMT_OUT" ]; then
                printf "%b\n" "${RED}[hooks] gofmt drift in $mod:${RESET}"
                printf "%s\n" "$FMT_OUT" | sed 's/^/    /'
                BLOCK=1
            fi
            if ! (cd ui/server && docker compose exec -T backend sh -c "cd ${mod_in_container} && go vet ./...") \
                    > /tmp/go-crypto-bot.ms-vet.out 2>&1; then
                printf "%b\n" "${RED}[hooks] go vet failures in $mod:${RESET}"
                tail -30 /tmp/go-crypto-bot.ms-vet.out | sed 's/^/    /'
                BLOCK=1
            fi
            if ! (cd ui/server && docker compose exec -T backend sh -c "cd ${mod_in_container} && go build ./...") \
                    > /tmp/go-crypto-bot.ms-build.out 2>&1; then
                printf "%b\n" "${RED}[hooks] go build failed in $mod:${RESET}"
                tail -30 /tmp/go-crypto-bot.ms-build.out | sed 's/^/    /'
                BLOCK=1
            fi
            if ! (cd ui/server && docker compose exec -T backend sh -c "cd ${mod_in_container} && go-lint ./...") \
                    > /tmp/go-crypto-bot.ms-ailint.out 2>&1; then
                # go-lint may not be installed in the backend image. Tail the
                # output so the user can decide whether it's a real finding
                # or "binary not found".
                printf "%b\n" "${YELLOW}[hooks] go-lint check in $mod:${RESET}"
                tail -30 /tmp/go-crypto-bot.ms-ailint.out | sed 's/^/    /'
                if grep -q 'not found' /tmp/go-crypto-bot.ms-ailint.out; then
                    printf "%b\n" "${GRAY}  Install inside the container: go install github.com/AndreyMashukov/go-lint/cmd/go-lint@latest${RESET}"
                else
                    BLOCK=1
                fi
            fi
        done <<< "$MS_MODS"
    fi
fi

# ---- Final verdict --------------------------------------------------------

if [ "$BLOCK" = "1" ]; then
    printf "%b\n" "${RED}[hooks] COMMIT BLOCKED — fix the issues above and re-stage.${RESET}"
    printf "%b\n" "${GRAY}  No bypass exists. Hook bugs are fixed in .githooks/ and committed separately.${RESET}"
    exit 1
fi

printf "%b\n" "${GREEN}[hooks] pre-commit OK.${RESET}"
exit 0
