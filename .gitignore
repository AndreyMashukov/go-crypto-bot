# Environment / secrets — never commit
.env
.env.local
.env.*.local
.env.production

# Generated docker-compose with real creds
docker-compose.yaml

# Dev artifacts
test2.csv
ml.go
*.log
trade.log
kline.log

# Build / test output
*.test
*.out
coverage.out
coverage.html

# ML runtime data (created by Dockerfile)
models/
results/
datasets/

# Local docker volume mounts — created by the compose stack, never commit
.docker/data/clickhouse-server/users.d/
.docker/data/redis/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Vendored deps (if ever generated)
vendor/

# Ansible inventory — production hostnames / SSH user / vault secrets
# never enter the repo. The shipped *.example file documents the schema;
# the real one comes from a GitHub Secret on CI runners (HOST_DEPLOY_INVENTORY)
# or from an out-of-tree path on the operator machine.
ui/deploy/inventory*
!ui/deploy/inventory.example.yml
ui/deploy/group_vars/
ui/deploy/host_vars/
ui/deploy/*.vault
ui/deploy/.vault_password
