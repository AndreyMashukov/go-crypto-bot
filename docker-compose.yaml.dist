version: '3.5'

x-bot-env: &bot-env
  BOT_UUID: '{BOT_UUID_4_HERE}'
  BOT_EXCHANGE: 'binance'
  CLICKHOUSE_DSN: 'clickhouse:8123'
  CLICKHOUSE_PASSWORD: '123456'
  DATABASE_DSN: 'postgres://go_crypto_bot:go_crypto_bot@postgres:5432/go_crypto_bot?sslmode=disable'
  REDIS_DSN: 'redis:6379'
  REDIS_PASSWORD: ''
  BINANCE_API_KEY: '{BINANCE_API_KEY}'
  BINANCE_API_SECRET: '{BINANCE_API_SECRET}'
  BINANCE_API_DSN: 'https://testnet.binance.vision'
  BINANCE_WS_DSN: 'wss://testnet.binance.vision/ws-api/v3'
  BINANCE_STREAM_DSN: 'wss://stream.binance.com'
  BYBIT_API_KEY: ''
  BYBIT_API_SECRET: ''
  BYBIT_API_DSN: ''
  BYBIT_STREAM_DSN: ''
  MC_DSN: "it should be your own capitalization service here"
  METRICS_LISTEN_ADDR: ':9101'

services:
  market-watcher:
    build:
      context: ./server
      dockerfile: Dockerfile
    image: go_crypto_bot:latest
    container_name: go_crypto_bot_market_watcher
    command: ["/usr/local/bin/market-watcher"]
    environment: *bot-env
    networks:
      - bot-net
    ports:
      - "9101:9101"
    restart: always
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_started
      clickhouse:
        condition: service_started
    volumes:
      - './server:/go/src/app/dev'

  market-trader:
    image: go_crypto_bot:latest
    container_name: go_crypto_bot_market_trader
    command: ["/usr/local/bin/market-trader"]
    environment: *bot-env
    networks:
      - bot-net
    ports:
      - "8090:8080"
    restart: always
    depends_on:
      market-watcher:
        condition: service_started
    volumes:
      - './server:/go/src/app/dev'

  prometheus:
    image: prom/prometheus:v2.51.0
    restart: unless-stopped
    networks:
      - bot-net
    ports:
      - "9090:9090"
    volumes:
      - ./.docker/etc/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.retention.time=30d'
      - '--storage.tsdb.path=/prometheus'
      - '--web.console.libraries=/usr/share/prometheus/console_libraries'
      - '--web.console.templates=/usr/share/prometheus/consoles'

  postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    ports:
      - "5444:5432"
    networks:
      - bot-net
    environment:
      POSTGRES_DB: go_crypto_bot
      POSTGRES_USER: go_crypto_bot
      POSTGRES_PASSWORD: go_crypto_bot
    volumes:
      - pg-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U go_crypto_bot -d go_crypto_bot"]
      interval: 5s
      timeout: 3s
      retries: 10

    # Redis
  redis:
    image: redis:5.0.5-alpine
    networks:
      - bot-net
    volumes:
      - ./.docker/data/redis:/data:delegated
#    ports:
#      - 6379:6379
    cap_add:
      - SYS_TIME
    restart: always

  clickhouse:
    image: clickhouse/clickhouse-server
    volumes:
      - clickhouse-data:/var/lib/clickhouse
      - ./.docker/data/clickhouse-server:/etc/clickhouse-server
    ports:
      - "8002:9000"
      - "9123:8123"
    ulimits:
      nproc: 65535
      nofile:
        soft: 262144
        hard: 262144
    networks:
      - bot-net

networks:
  bot-net:
    driver: bridge

volumes:
  pg-data:
    name: go_crypto_bot_pg_data
  clickhouse-data:
    name: go_crypto_bot_clickhouse_data
  prometheus-data:
    name: go_crypto_bot_prometheus_data
