FROM php:8.4-zts-bookworm

ARG DEPLOY_SERVICE_IP
ARG MESSENGER_TRANSPORT_DSN
ARG ACCESS_TOKEN_TTL
ARG APP_ENV_VALUE=prod
ARG DATABASE_URL_VALUE
ARG REDIS_DSN_VALUE
ARG BREVO_API_KEY
ARG OXA_PAY_API_KEY
ARG BACK_END_HOST
ARG FRONT_END_HOST
ARG INTERNAL_SERVICE_TOKEN
ARG CLICKHOUSE_DSN
ARG CLICKHOUSE_PASSWORD

WORKDIR /srv/www

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        autoconf \
        bash \
        ca-certificates \
        cron \
        curl \
        ffmpeg \
        gcc \
        git \
        libcap2-bin \
        libfreetype6-dev \
        libicu-dev \
        libjpeg-dev \
        libonig-dev \
        libpng-dev \
        libpq-dev \
        libwebp-dev \
        libxml2-dev \
        libxslt1-dev \
        libzip-dev \
        make \
        postgresql-client \
        supervisor \
        unzip \
        webp \
        zlib1g-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(nproc)" \
        bcmath \
        gd \
        iconv \
        intl \
        mbstring \
        opcache \
        pcntl \
        pdo_pgsql \
        sockets \
        xsl \
        zip \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# php-parallax — Go/Rust-semantic concurrency primitive for PHP 8.4 ZTS.
ENV PHP_PARALLAX_VERSION=0.2.1
RUN curl -fsSL "https://github.com/AndreyMashukov/php-parallax/archive/refs/tags/v${PHP_PARALLAX_VERSION}.tar.gz" | tar xz -C /tmp \
    && cd "/tmp/php-parallax-${PHP_PARALLAX_VERSION}" \
    && phpize \
    && ./configure --enable-parallax \
    && make -j"$(nproc)" \
    && make install \
    && echo "extension=parallax.so" > /usr/local/etc/php/conf.d/parallax.ini \
    && php -m | grep parallax \
    && cd / && rm -rf "/tmp/php-parallax-${PHP_PARALLAX_VERSION}"

# RoadRunner replaces FPM + nginx.
ENV RR_VERSION=2025.1.13
RUN curl -fsSL "https://github.com/roadrunner-server/roadrunner/releases/download/v${RR_VERSION}/roadrunner-${RR_VERSION}-linux-amd64.tar.gz" | tar xz -C /tmp \
    && mv "/tmp/roadrunner-${RR_VERSION}-linux-amd64/rr" /usr/local/bin/rr \
    && chmod +x /usr/local/bin/rr \
    && rm -rf "/tmp/roadrunner-${RR_VERSION}-linux-amd64"

COPY --from=composer:2.8 /usr/bin/composer /usr/local/bin/composer

COPY --from=golang:1.21-bookworm /usr/local/go/ /usr/local/go/
ENV PATH="/usr/local/go/bin:${PATH}"
ENV CGO_ENABLED=1

COPY .docker/etc/cron.d/prod /etc/cron.d/app
COPY .docker/etc/supervisord/supervisord.conf /etc/supervisor/supervisord.conf
COPY .docker/etc/php/php-cli.ini /usr/local/etc/php/conf.d/60-cli.ini

RUN mkdir -p /srv/www/var/cache /srv/www/var/log \
    && chmod 644 /etc/cron.d/app

COPY . /srv/www

ENV COMPOSER_ALLOW_SUPERUSER=1

RUN cd /srv/www/microservices/signal-server \
    && go mod download \
    && go build -o signal-server main.go

RUN cd /srv/www \
    && APP_ENV=prod composer install --no-dev --no-interaction --optimize-autoloader --no-progress --no-scripts \
    && chown -R www-data:www-data /srv/www/public /srv/www/var

ENV APP_ENV=$APP_ENV_VALUE
ENV DEPLOY_SERVICE_IP=$DEPLOY_SERVICE_IP
ENV MESSENGER_TRANSPORT_DSN=$MESSENGER_TRANSPORT_DSN
ENV DATABASE_URL=$DATABASE_URL_VALUE
ENV REDIS_DSN=$REDIS_DSN_VALUE
ENV ACCESS_TOKEN_TTL=$ACCESS_TOKEN_TTL
ENV BREVO_API_KEY=$BREVO_API_KEY
ENV OXA_PAY_API_KEY=$OXA_PAY_API_KEY
ENV BACK_END_HOST=$BACK_END_HOST
ENV FRONT_END_HOST=$FRONT_END_HOST
ENV INTERNAL_SERVICE_TOKEN=$INTERNAL_SERVICE_TOKEN
ENV CLICKHOUSE_DSN=$CLICKHOUSE_DSN
ENV CLICKHOUSE_PASSWORD=$CLICKHOUSE_PASSWORD

EXPOSE 80

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/supervisord.conf"]
